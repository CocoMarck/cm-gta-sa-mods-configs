# Default - auto detect text files
* text=auto

# Shell scripts - always LF (Linux needs this)
*.sh text eol=lf

# Windows batch - always CRLF (cmd needs Windows line endings)
*.bat text eol=crlf

# Mod configs - always CRLF (GTA SA mods expect Windows format)
*.ini text eol=crlf

# Markdown - LF
*.md text eol=lf
